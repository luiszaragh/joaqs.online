---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import Section from '../components/Section.astro';
import CertBadge from '../components/CertBadge.astro';
import AnimatedText from '../components/AnimatedText.astro';
import { profile, experience, projects, skills } from '../data/profile';
import { posts, statusLabels as postStatusLabels } from '../data/posts';

// DECISIONS.md #47 — the graduation photograph, EXIF-stripped and resized by
// scripts/portrait/prepare-web.mjs before it was ever committed. The original
// stays gitignored; only this cleaned copy ships.
import gradPhoto from '../assets/graduation.jpg';

const { certifications: certs, links } = profile;

const title = `${profile.name} — ${profile.role}`;
const description = `${profile.role} in ${profile.location.region}. AWS-certified (${certs.earned
  .map((c) => c.code)
  .join(', ')}). ${profile.availability}`;

const statusLabels: Record<string, string> = {
  live: 'Live',
  rework: 'In rework',
  pending: 'Write-up pending',
};
---

<DocumentLayout title={title} description={description}>
  <main id="main" class="doc">
      {/* 00 — header */}
      <header class="masthead reveal" id="top" data-section-id="00" data-section-label="Header" data-reveal>
        <h1 aria-label={profile.fullName}><AnimatedText text={profile.fullName} /></h1>
        <div class="reveal-body">
          <p class="role">{profile.role}</p>
          <p class="subline">
            AWS-certified ({certs.earned.map((c) => c.code).join(', ')}) · {profile.availability}
          </p>
        </div>
      </header>

      <Section id="01" slug="about" label="About">
        <div class="about-lead">
          <img
            class="grad-photo"
            src={gradPhoto.src}
            width={gradPhoto.width}
            height={gradPhoto.height}
            alt="Luis at his 2026 graduation"
            loading="lazy"
          />
          <div class="about-text">
            <p>{profile.intro}</p>
            <p class="muted">{profile.level}</p>
            <p class="muted">
              {profile.location.city} · {profile.location.arrangements.join(' · ')}
            </p>
          </div>
        </div>
      </Section>

      <Section id="02" slug="certifications" label="Certifications">
        <ul class="certs">
          {
            certs.earned.map((c) => (
              <li>
                <CertBadge tier={c.tier} />
                <span class="code">{c.code}</span>
                <span>{c.name}</span>
              </li>
            ))
          }
        </ul>
        <p class="rule-label">In progress</p>
        <ul class="certs certs--pending">
          {
            certs.inProgress.map((c) => (
              <li>
                <CertBadge tier={c.tier} pending />
                <span class="code">{c.code}</span>
                <span>{c.name}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="03" slug="projects" label="Projects">
        <ol class="projects">
          {
            projects.map((project) => (
              <li class="project">
                <div class="project-head">
                  <h3>{project.title}</h3>
                  <span class:list={['badge', `badge--${project.status}`]}>
                    {statusLabels[project.status]}
                  </span>
                </div>
                <p>{project.summary}</p>
                {project.statusNote && <p class="muted small">{project.statusNote}</p>}
                <ul class="stack">
                  {project.stack.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
                {
                  project.status === 'live' && (
                    <p class="links">
                      <a href={`/projects/${project.slug}/`}>Read the write-up</a>
                      {project.repo && (
                        <>
                          <span class="sep" aria-hidden="true">·</span>
                          <a href={project.repo} rel="noopener">
                            Source
                          </a>
                        </>
                      )}
                    </p>
                  )
                }
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="04" slug="blog" label="Blog">
        {/* DECISIONS.md #46 — the blog lives at /blog; this section is its
            table of contents, from the same data file, plus the way there. */}
        <p>
          Write-ups from building and running this site — the deployment, the security gates, and
          the decisions behind both.
        </p>
        <ul class="post-list">
          {
            posts.map((post) => (
              <li>
                <span class="post-title">{post.title}</span>
                <span class="badge">{postStatusLabels[post.status]}</span>
              </li>
            ))
          }
        </ul>
        <p class="links">
          <a class="button" href="/blog/">All posts →</a>
        </p>
      </Section>

      <Section id="05" slug="experience" label="Experience">
        <ol class="roles">
          {
            experience.map((role) => (
              <li class="role-entry">
                <div class="role-head">
                  <h3>
                    {role.role} <span class="org">· {role.org}</span>
                  </h3>
                  <p class="meta">
                    {role.start} – {role.end} · {role.duration} · {role.location}
                  </p>
                </div>
                <ul class="bullets">
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="06" slug="skills" label="Skills">
        <dl class="skills">
          {
            skills.map((group) => (
              <div class="skill-group">
                <dt>{group.group}</dt>
                <dd>{group.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <Section id="07" slug="contact" label="Contact">
        <ul class="contact">
          <li>
            <span class="label">Email</span>
            <button class="value copy" type="button" data-copy={profile.email}>
              <span data-copy-text>{profile.email}</span>
            </button>
          </li>
          <li>
            <span class="label">GitHub</span>
            <a class="value" href={links.github} rel="noopener">
              {links.github.replace('https://', '')}
            </a>
          </li>
          {
            links.linkedin && (
              <li>
                <span class="label">LinkedIn</span>
                <a class="value" href={links.linkedin} rel="noopener">
                  {links.linkedin.replace('https://www.', '').replace('https://', '')}
                </a>
              </li>
            )
          }
        </ul>
      </Section>
  </main>
</DocumentLayout>

<style>
  /* The document column centres itself in whatever width the navigation
     panel leaves it (DocumentLayout shifts the whole window right of the
     panel), so the reading margins survive at every width. */
  .doc {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--page-gutter) var(--space-2xl);
  }

  .masthead {
    scroll-margin-top: calc(var(--chrome-height) + var(--space-sm));
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
    margin-bottom: var(--space-xl);
  }

  .role {
    margin-top: var(--space-2xs);
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .subline {
    margin-top: var(--space-sm);
    max-width: var(--measure-narrow);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-ink-3);
  }

  p + p {
    margin-top: var(--space-sm);
  }

  .muted {
    color: var(--color-ink-2);
  }

  .small {
    font-size: var(--text-sm);
  }

  h3 {
    font-size: var(--text-lg);
  }

  /* --- about --- */
  .about-lead {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .grad-photo {
    flex: none;
    width: 12rem;
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
  }

  .about-text p + p {
    margin-top: var(--space-sm);
  }

  @media (max-width: 40rem) {
    .about-lead {
      flex-direction: column;
    }

    .grad-photo {
      width: min(16rem, 100%);
    }
  }

  /* --- certifications --- */
  .certs {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .certs li {
    display: grid;
    grid-template-columns: 1.25rem 7.5rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .code {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-3);
  }

  .rule-label {
    margin-top: var(--space-md);
    padding-top: var(--space-2xs);
    border-top: var(--rule-hairline) solid var(--color-rule);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .certs--pending {
    margin-top: var(--space-2xs);
    color: var(--color-ink-2);
  }

  /* --- projects --- */
  .projects,
  .roles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  .project-head,
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    margin-bottom: var(--space-2xs);
  }

  .badge {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 2px var(--space-2xs);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
  }

  .badge--live {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-2xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .stack li::after {
    content: ' ·';
  }

  .stack li:last-child::after {
    content: '';
  }

  .links {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .sep {
    color: var(--color-ink-3);
    margin-inline: var(--space-3xs);
  }

  /* --- blog --- */
  .post-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .post-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .post-title {
    font-weight: var(--weight-medium);
  }

  .button {
    display: inline-block;
    padding: var(--space-3xs) var(--space-sm);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-chrome);
    color: var(--color-ink);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .button:hover {
    background: var(--color-paper-2);
    color: var(--color-ink);
  }

  /* --- experience --- */
  .meta {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .org {
    color: var(--color-ink-2);
    font-weight: var(--weight-regular);
  }

  .bullets {
    margin-top: var(--space-2xs);
    padding-left: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .bullets li {
    max-width: var(--measure);
  }

  /* --- skills --- */
  .skills {
    display: grid;
    gap: var(--space-sm);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .skills dt {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .skills dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* --- contact --- */
  .contact {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .contact li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .label {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .value {
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* DECISIONS.md #28 — click to copy, with confirmation. No mailto: (breaks on
     desktops with no mail client) and no contact form. */
  .copy {
    justify-self: start;
    padding: 0;
    background: none;
    border: 0;
    border-bottom: var(--rule-hairline) dashed var(--color-rule);
    color: var(--color-accent);
    text-align: left;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 34rem) {
    .certs li {
      grid-template-columns: 1.25rem minmax(0, 1fr);
    }

    .certs li span:last-child {
      grid-column: 2;
    }

    .contact li,
    .skill-group {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const text = document.querySelector<HTMLElement>('[data-copy-text]');

  button?.addEventListener('click', async () => {
    const address = button.dataset.copy ?? '';
    const original = address;
    try {
      await navigator.clipboard.writeText(address);
      if (text) {
        text.textContent = 'Copied to clipboard';
        setTimeout(() => {
          text.textContent = original;
        }, 1600);
      }
    } catch {
      // Clipboard permission can be refused. The address is already on screen,
      // so the user can still select it — better than a button that appears
      // to do nothing.
    }
  });
</script>
