---
import DocumentLayout from '../layouts/DocumentLayout.astro';
import Section from '../components/Section.astro';
import CertCarousel from '../components/CertCarousel.astro';
import AnimatedText from '../components/AnimatedText.astro';
import { profile, experience, projects, skills } from '../data/profile';
import { posts, statusLabels as postStatusLabels } from '../data/posts';

// DECISIONS.md #47 — the graduation photograph, EXIF-stripped and resized by
// scripts/portrait/prepare-web.mjs before it was ever committed. The original
// stays gitignored; only this cleaned copy ships.
import gradPhoto from '../assets/graduation.jpg';
// The Bayer-dithered variant (#51), black-on-transparent: used as a CSS mask
// over an ink-coloured layer so the dots follow the theme. Hover reveals the
// real photo underneath.
import gradDither from '../assets/graduation-dither.png';

const { certifications: certs, links } = profile;

const title = `${profile.name} — ${profile.role}`;
const description = `${profile.role} in ${profile.location.region}. AWS-certified (${certs.earned
  .map((c) => c.code)
  .join(', ')}). ${profile.availability}`;

const statusLabels: Record<string, string> = {
  live: 'Live',
  rework: 'In rework',
  pending: 'Write-up pending',
};
---

<DocumentLayout title={title} description={description}>
  <main id="main" class="doc">
      {/* 00 — header */}
      <header class="masthead reveal" id="top" data-section-id="00" data-section-label="Header" data-reveal>
        <h1 aria-label={profile.fullName}><AnimatedText text={profile.fullName} /></h1>
        <div class="reveal-body">
          <p class="role">{profile.role}</p>
          <p class="subline">
            AWS-certified ({certs.earned.map((c) => c.code).join(', ')}) · {profile.availability}
          </p>
        </div>
      </header>

      <Section id="01" slug="about" label="About">
        <div class="about-lead">
          {/* Dither on top, photo beneath; hover or tap crossfades them.
              A button, so keyboards and screen readers get the same toggle. */}
          <button
            class="grad-photo"
            type="button"
            data-photo-toggle
            aria-pressed="false"
            aria-label="Show the real photograph"
            style={`--dither: url(${gradDither.src})`}
          >
            <img
              src={gradPhoto.src}
              width={gradPhoto.width}
              height={gradPhoto.height}
              alt="Luis at his 2026 graduation"
              loading="lazy"
              draggable="false"
            />
            <span class="dither" aria-hidden="true"></span>
          </button>
          <div class="about-text">
            <p>{profile.intro}</p>
            <p class="muted">{profile.level}</p>
            <p class="muted">
              {profile.location.city} · {profile.location.arrangements.join(' · ')}
            </p>
          </div>
        </div>
      </Section>

      <Section id="02" slug="certifications" label="Certifications">
        <CertCarousel />
        <p class="rule-label">In progress</p>
        <ul class="certs certs--pending">
          {
            certs.inProgress.map((c) => (
              <li>
                <span class="code">{c.code}</span>
                <span>{c.name}</span>
              </li>
            ))
          }
        </ul>
      </Section>

      <Section id="03" slug="projects" label="Projects">
        <ol class="projects">
          {
            projects.map((project) => (
              <li class="project">
                <div class="project-head">
                  <h3>{project.title}</h3>
                  <span class:list={['badge', `badge--${project.status}`]}>
                    {statusLabels[project.status]}
                  </span>
                </div>
                <p>{project.summary}</p>
                <ul class="stack">
                  {project.stack.map((tool) => (
                    <li>{tool}</li>
                  ))}
                </ul>
                {
                  project.status === 'live' && (
                    <p class="links">
                      <a href={`/projects/${project.slug}/`}>Read the write-up</a>
                      {project.repo && (
                        <>
                          <span class="sep" aria-hidden="true">·</span>
                          <a href={project.repo} target="_blank" rel="noopener noreferrer">
                            Source
                          </a>
                        </>
                      )}
                    </p>
                  )
                }
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="04" slug="blog" label="Blog">
        {/* DECISIONS.md #46 — the blog lives at /blog; this section is its
            table of contents, from the same data file, plus the way there. */}
        <p>
          Write-ups from building and running this site — the deployment, the security gates, and
          the decisions behind both.
        </p>
        <ul class="post-list">
          {
            posts.map((post) => (
              <li>
                {
                  post.status === 'published' ? (
                    <a class="post-title" href={`/blog/${post.slug}/`}>
                      {post.title}
                    </a>
                  ) : (
                    <span class="post-title">{post.title}</span>
                  )
                }
                <span class="badge">{postStatusLabels[post.status]}</span>
              </li>
            ))
          }
        </ul>
        <p class="links">
          <a class="button" href="/blog/">All posts →</a>
        </p>
      </Section>

      <Section id="05" slug="experience" label="Experience">
        <ol class="roles">
          {
            experience.map((role) => (
              <li class="role-entry">
                <div class="role-head">
                  <h3>
                    {role.role} <span class="org">· {role.org}</span>
                  </h3>
                  <p class="meta">
                    {role.start} – {role.end} · {role.duration} · {role.location}
                  </p>
                </div>
                <ul class="bullets">
                  {role.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              </li>
            ))
          }
        </ol>
      </Section>

      <Section id="06" slug="skills" label="Skills">
        <dl class="skills">
          {
            skills.map((group) => (
              <div class="skill-group">
                <dt>{group.group}</dt>
                <dd>{group.items.join(' · ')}</dd>
              </div>
            ))
          }
        </dl>
      </Section>

      <Section id="07" slug="contact" label="Contact">
        <ul class="contact">
          <li>
            <span class="label">Email</span>
            <button class="value copy" type="button" data-copy={profile.email}>
              <span data-copy-text>{profile.email}</span>
            </button>
            {/* The button swaps its own label to confirm, which a screen
                reader will not reliably re-announce for the element it is
                already sitting on. This region carries the confirmation
                instead. It is absolutely positioned, so it takes no grid
                slot, and it ships empty so the live region exists before it
                has anything to say. */}
            <span class="visually-hidden" role="status" data-copy-status></span>
          </li>
          <li>
            <span class="label">GitHub</span>
            <a class="value" href={links.github} target="_blank" rel="noopener noreferrer">
              {links.github.replace('https://', '')}
            </a>
          </li>
          {/* #51 — the résumé lives here too, so phones (no sidebar) keep the
              download after the File menu's removal. */}
          <li>
            <span class="label">Résumé</span>
            <a class="value" href="/resume.pdf" download="ZARA, Luis Joaquin_Resume.pdf">
              ZARA, Luis Joaquin_Resume.pdf
            </a>
          </li>
          {
            links.linkedin && (
              <li>
                <span class="label">LinkedIn</span>
                <a class="value" href={links.linkedin} target="_blank" rel="noopener noreferrer">
                  {links.linkedin.replace('https://www.', '').replace('https://', '')}
                </a>
              </li>
            )
          }
        </ul>
      </Section>
  </main>
</DocumentLayout>

<style>
  /* The document column centres itself in whatever width the navigation
     panel leaves it (DocumentLayout shifts the whole window right of the
     panel), so the reading margins survive at every width. */
  .doc {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-xl) var(--page-gutter) var(--space-2xl);
  }

  .masthead {
    scroll-margin-top: calc(var(--chrome-height) + var(--space-sm));
    padding-bottom: var(--space-lg);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
    margin-bottom: var(--space-xl);
  }

  .role {
    margin-top: var(--space-2xs);
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .subline {
    margin-top: var(--space-sm);
    max-width: var(--measure-narrow);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    color: var(--color-ink-3);
  }

  p + p {
    margin-top: var(--space-sm);
  }

  .muted {
    color: var(--color-ink-2);
  }

  .small {
    font-size: var(--text-sm);
  }

  h3 {
    font-size: var(--text-lg);
  }

  /* --- about --- */
  .about-lead {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  /* The photo is a two-layer stack: the real photograph, with the dithered
     mask layer painted in ink on top. Hover (or tap — it is a button) fades
     the dither away. The mask trick is why one PNG serves both themes: the
     dots are whatever --color-ink currently is. */
  .grad-photo {
    position: relative;
    flex: none;
    width: 12rem;
    padding: 0;
    background: var(--color-paper);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
  }

  .grad-photo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .grad-photo .dither {
    position: absolute;
    inset: 0;
    background: var(--color-ink);
    -webkit-mask-image: var(--dither);
    mask-image: var(--dither);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    opacity: 1;
    transition: opacity 420ms var(--ease-in-out);
  }

  /* Behind the dither sits the paper, not the photo, until asked. */
  .grad-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-paper);
    opacity: 1;
    transition: opacity 420ms var(--ease-in-out);
  }

  @media (hover: hover) {
    .grad-photo:hover .dither,
    .grad-photo:hover::before {
      opacity: 0;
    }
  }

  .grad-photo:focus-visible .dither,
  .grad-photo:focus-visible::before,
  .grad-photo[aria-pressed='true'] .dither,
  .grad-photo[aria-pressed='true']::before {
    opacity: 0;
  }

  .about-text p + p {
    margin-top: var(--space-sm);
  }

  @media (max-width: 40rem) {
    .about-lead {
      flex-direction: column;
    }

    .grad-photo {
      width: min(16rem, 100%);
    }
  }

  /* --- certifications --- */
  .certs {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .certs li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .code {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-ink-3);
  }

  .rule-label {
    margin-top: var(--space-md);
    padding-top: var(--space-2xs);
    border-top: var(--rule-hairline) solid var(--color-rule);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .certs--pending {
    margin-top: var(--space-2xs);
    color: var(--color-ink-2);
  }

  /* --- projects --- */
  .projects,
  .roles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-lg);
  }

  /* #51 micro-interaction: entries lift a touch and pick up an accent edge.
     The transparent border exists at rest so nothing reflows on hover. */
  .project {
    padding-left: var(--space-sm);
    margin-left: calc(-1 * var(--space-sm));
    border-left: var(--rule-thick) solid transparent;
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .project:hover {
      transform: translateY(-2px);
      border-left-color: var(--color-accent);
    }
  }

  .project-head,
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    margin-bottom: var(--space-2xs);
  }

  .badge {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 2px var(--space-2xs);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
  }

  .badge--live {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3xs) var(--space-2xs);
    list-style: none;
    padding: 0;
    margin-top: var(--space-2xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .stack li::after {
    content: ' ·';
  }

  .stack li:last-child::after {
    content: '';
  }

  .links {
    margin-top: var(--space-2xs);
    font-size: var(--text-sm);
  }

  .sep {
    color: var(--color-ink-3);
    margin-inline: var(--space-3xs);
  }

  /* --- blog --- */
  .post-list {
    list-style: none;
    padding: 0;
    margin-top: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .post-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
  }

  .post-title {
    font-weight: var(--weight-medium);
  }

  .button {
    display: inline-block;
    padding: var(--space-3xs) var(--space-sm);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-chrome);
    color: var(--color-ink);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .button:hover {
    background: var(--color-paper-2);
    color: var(--color-ink);
  }

  /* --- experience --- */
  .meta {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .org {
    color: var(--color-ink-2);
    font-weight: var(--weight-regular);
  }

  .bullets {
    margin-top: var(--space-2xs);
    padding-left: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
  }

  .bullets li {
    max-width: var(--measure);
  }

  /* --- skills --- */
  .skills {
    display: grid;
    gap: var(--space-sm);
  }

  .skill-group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .skills dt {
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .skills dd {
    margin: 0;
    font-size: var(--text-sm);
  }

  /* --- contact --- */
  .contact {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2xs);
  }

  .contact li {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: var(--space-2xs);
    align-items: baseline;
  }

  .label {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .value {
    font-family: var(--font-chrome);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* DECISIONS.md #28 — click to copy, with confirmation. No mailto: (breaks on
     desktops with no mail client) and no contact form. */
  .copy {
    justify-self: start;
    padding: 0;
    background: none;
    border: 0;
    border-bottom: var(--rule-hairline) dashed var(--color-rule);
    color: var(--color-accent);
    text-align: left;
    cursor: pointer;
  }

  .copy:hover {
    color: var(--color-accent-hover);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 34rem) {
    .certs li,
    .contact li,
    .skill-group {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3xs);
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const text = document.querySelector<HTMLElement>('[data-copy-text]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  button?.addEventListener('click', async () => {
    const address = button.dataset.copy ?? '';
    const original = address;
    try {
      await navigator.clipboard.writeText(address);
      if (text) {
        text.textContent = 'Copied to clipboard';
        setTimeout(() => {
          text.textContent = original;
        }, 1600);
      }
      // Cleared first: clicking twice in a row writes the same string, and a
      // live region that has not changed announces nothing.
      if (status) {
        status.textContent = '';
        status.textContent = 'Email address copied to clipboard.';
      }
    } catch {
      // Clipboard permission can be refused. The address is already on screen,
      // so the user can still select it — better than a button that appears
      // to do nothing. Sighted readers can see that; this says it.
      if (status) {
        status.textContent = '';
        status.textContent = `Copy failed. The address is ${address} and can be selected from the page.`;
      }
    }
  });

  // --- photo toggle (#51) -----------------------------------------------
  // Hover handles pointers; this handles taps and keyboards. aria-pressed
  // doubles as the styling hook, so state and appearance cannot disagree.
  const photo = document.querySelector<HTMLButtonElement>('[data-photo-toggle]');
  photo?.addEventListener('click', () => {
    const shown = photo.getAttribute('aria-pressed') === 'true';
    photo.setAttribute('aria-pressed', String(!shown));
    photo.setAttribute(
      'aria-label',
      shown ? 'Show the real photograph' : 'Show the dithered portrait',
    );
  });
</script>
