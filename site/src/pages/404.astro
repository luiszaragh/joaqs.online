---
import DocumentLayout from '../layouts/DocumentLayout.astro';

// CloudFront maps both 403 and 404 to this page — a private S3 bucket answers
// "missing key" with 403, not 404, because the bucket policy grants GetObject
// and not ListBucket. infra/modules/site/cloudfront.tf
//
// The whole column is the reveal target rather than a wrapper inside it: there
// is one block of content here, which is exactly the case .reveal-fade exists
// for. This page was the one left out when the project and blog pages got
// their reveal markup, so it alone appeared instantly while every other page
// faded in.
---

<DocumentLayout
  title="Not found — Luis Zara"
  description="That page does not exist on this site."
  statusLabel="Error 404"
  noindex
>
  <main id="main" class="doc reveal-fade" data-reveal>
    <p class="code">Error 404</p>
    <h1>That file isn&rsquo;t here.</h1>
    <p>
      The address is either mistyped or points at something that has since moved.
      <a href="/">Back to the front page.</a>
    </p>
  </main>
</DocumentLayout>

<style>
  .doc {
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--space-2xl) var(--page-gutter);
  }

  .code {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
    margin-bottom: var(--space-sm);
  }

  /* The same size every other subpage title uses. This was --text-3xl, a step
     no other heading in the site reaches for, which made the error page the
     one place the display scale broke. */
  h1 {
    font-size: var(--text-display-s);
  }

  h1 + p {
    margin-top: var(--space-md);
  }
</style>
