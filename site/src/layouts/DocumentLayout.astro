---
import BaseLayout from './BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import MenuBar from '../components/MenuBar.astro';
import StatusBar from '../components/StatusBar.astro';
import ChatDialog from '../components/ChatDialog.astro';

// Navigation panel on the left, menu bar above the document, status bar
// below it (DECISIONS.md #46/#47). The panel lives here rather than on the
// home page so every page — blog, project write-ups — carries the same
// navigation; its links are root-anchored for exactly that reason.

interface Props {
  title: string;
  description: string;
  /** Overrides the status bar's section field on pages that do not scroll through sections. */
  statusLabel?: string;
  /** Pages with no canonical address of their own — see BaseLayout. */
  noindex?: boolean;
}

const { title, description, statusLabel, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SideNav />

  <div class="window">
    <header class="chrome">
      <MenuBar />
    </header>

    <slot />

    <StatusBar staticLabel={statusLabel} />
  </div>

  {/* One dialog per page. Its triggers live in the sidebar and the menu bar
      and bind by attribute, so both widths can reach it. */}
  <ChatDialog />
</BaseLayout>

<style>
  .window {
    min-height: 100dvh;
    /* Clears the fixed status bar so the last line of the document is never
       hidden behind it. */
    padding-bottom: calc(var(--chrome-height) + var(--space-md));
  }

  /* The document shifts right of the fixed panel; below 60rem the panel is
     hidden and the document takes the full width back. */
  @media (min-width: 60rem) {
    .window {
      margin-left: var(--sidebar-width);
    }
  }

  .chrome {
    position: sticky;
    top: 0;
    z-index: 50;
  }
</style>
