---
import BaseLayout from './BaseLayout.astro';
import SideNav from '../components/SideNav.astro';
import StatusBar from '../components/StatusBar.astro';
import ChatDialog from '../components/ChatDialog.astro';
import ChatLauncher from '../components/ChatLauncher.astro';

// Navigation panel on the left, the document, status bar below, and the
// floating assistant bottom-right (DECISIONS.md #47/#51). The top bar is
// gone — #51 removed the last piece of the WordPad chrome once everything it
// held had a better home: résumé in the sidebar and Contact, theme control in
// the sidebar and status bar, view-source covered by the status bar's commit
// link.

interface Props {
  title: string;
  description: string;
  /** Overrides the status bar's section field on pages that do not scroll through sections. */
  statusLabel?: string;
  /** Pages with no canonical address of their own — see BaseLayout. */
  noindex?: boolean;
}

const { title, description, statusLabel, noindex } = Astro.props;
---

<BaseLayout title={title} description={description} noindex={noindex}>
  <SideNav />

  <div class="window">
    <slot />

    <StatusBar staticLabel={statusLabel} />
  </div>

  {/* One dialog per page; the launcher (and Alt+K) opens it. */}
  <ChatDialog />
  <ChatLauncher />
</BaseLayout>

<style>
  .window {
    min-height: 100dvh;
    /* Clears the fixed status bar so the last line of the document is never
       hidden behind it. */
    padding-bottom: calc(var(--chrome-height) + var(--space-md));
  }

  /* The document shifts right of the fixed panel; below 60rem the panel is
     hidden and the document takes the full width back. */
  @media (min-width: 60rem) {
    .window {
      margin-left: var(--sidebar-width);
    }
  }
</style>
