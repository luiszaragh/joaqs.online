---
import '../styles/global.css';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
  /**
   * For pages that must not be indexed and have no canonical address of their
   * own — the 404 page is the only one. Its URL is whatever the visitor
   * mistyped, so a canonical link there would point at a page that answers 404
   * by design, which is both wrong for search engines and a broken link to any
   * checker that follows it.
   */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

// DECISIONS.md #25 — every absolute URL derives from Astro.site. There is no
// literal domain in this file, and there must never be one.
const canonical = new URL(Astro.url.pathname, Astro.site).href;

// DECISIONS.md #38 — one static OG image for the whole site, not per-page
// generation. This link gets pasted into LinkedIn posts and applications, and
// a link with no preview card looks broken before anyone clicks it.
// Regenerate with: node scripts/og/generate.mjs
const ogImage: string | null = '/og.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={profile.name} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site).href} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    {/* DECISIONS.md #23 — a document glyph. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {/*
      Both faces are needed above the fold — the serif for the masthead, the
      mono for the title and menu bars — so the browser should not wait to
      discover them inside a stylesheet. `crossorigin` is required even though
      these are same-origin: fonts are always fetched in CORS mode, and without
      it the preload is discarded and the file downloaded a second time.
    */}
    <link
      rel="preload"
      href="/fonts/source-serif-4-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/ibm-plex-mono-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/*
      Applies the stored theme before first paint so the View-menu toggle
      (M3) never flashes the wrong palette. Inline and blocking on purpose.
      No stored value means the OS preference wins, which is what tokens.css
      already does — so this script only ever writes an explicit choice.
    */}
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.dataset.theme = stored;
        }
      } catch {
        /* private mode, blocked storage — the OS preference is a fine default */
      }

      // Arms the scroll-reveal and letter animations (global.css gates every
      // hidden initial state on html[data-animate]). Set here, before paint,
      // and only when motion is welcome. With JavaScript off this never runs,
      // so nothing is ever hidden for a reader the observer can't reach.
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.animate = '';
      }
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    <script>
      // One observer reveals everything marked data-reveal, once, the first
      // time it enters the viewport. Elements already on screen at load are
      // revealed by the observer's initial callback, so the top of the page
      // animates in immediately.
      const revealables = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (document.documentElement.dataset.animate !== undefined && revealables.length > 0) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('in');
              observer.unobserve(entry.target);
            }
          },
          // Fire a little before the element's top edge would demand it, so
          // the animation is already moving as the reader arrives.
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
        );

        const arm = () => {
          for (const el of revealables) observer.observe(el);
        };
        arm();

        // DECISIONS.md #51 — the animations replay on back/forward. The
        // back/forward cache restores this page exactly as it was left, .in
        // classes and all, so returning from /blog/ showed a finished page
        // with nothing to fade. `pageshow` with `persisted` is the one signal
        // that a restore (not a load) just happened: strip the classes and
        // re-observe, and whatever is on screen fades in again.
        window.addEventListener('pageshow', (event) => {
          if (!event.persisted) return;
          for (const el of revealables) el.classList.remove('in');
          arm();
        });
      } else {
        // Reduced motion or no observer targets: make sure nothing marked
        // stays at its hidden initial state.
        for (const el of revealables) el.classList.add('in');
      }
    </script>
  </body>
</html>
