---
// DECISIONS.md #16, #23 — the document's title bar. Reads as a filename
// because the whole site is dressed as a document, and `.rtf` specifically
// because that is what WordPad saves.
//
// This is chrome that is honest about being decorative: it is the one element
// with no function. Everything else in the chrome does something.
---

<div class="titlebar">
  <span class="icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="14" height="14" focusable="false">
      <path d="M5 2h14l8 8v20H5z" fill="currentColor" opacity="0.35" />
      <path d="M6.5 3.5h12v7.5H26v17.5H6.5z" fill="currentColor" />
      <path d="M20 3.6 25.4 9.5H20z" fill="currentColor" opacity="0.35" />
    </svg>
  </span>
  <span class="filename">luis_zara.rtf</span>
</div>

<style>
  .titlebar {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    height: var(--chrome-height);
    padding-inline: var(--space-xs);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    user-select: none;
  }

  .icon {
    display: flex;
    flex: none;
    color: var(--color-on-accent);
  }

  .filename {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
</style>
