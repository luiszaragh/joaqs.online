---
import { profile } from '../data/profile';

// The certifications as a true moving carousel (DECISIONS.md #51b): a strip
// of cards drifting right-to-left continuously, fading out at the left edge
// and in at the right — the ticker pattern from Luis's reference. It stops
// the moment the reader engages: hover pauses it, a click pins it, focus
// pauses it for keyboard users.
//
// Each card is the official Credly emblem plus a verify link — the design
// goal is proof, not decoration: a recruiter clicks through and checks the
// badge themselves.
//
// The loop is two identical sets of cards on one track, animated by exactly
// half its width; when the animation wraps, the second set is standing where
// the first began and the seam is invisible. The second set is aria-hidden
// with untabbable links: a screen reader or Tab key meets each cert once.
//
// Reduced motion, or no JavaScript for the click-to-pin: the CSS handles it —
// the global reduced-motion rule flattens the animation and a media query
// below swaps the strip for a plain scrollable row.

const certs = profile.certifications.earned;

const monthLabel = (ym: string | null) => {
  if (!ym) return null;
  const [y, m] = ym.split('-').map(Number);
  return new Date(y, (m ?? 1) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<div class="carousel" data-carousel aria-label="AWS certifications">
  <div class="track" data-carousel-track>
    {
      [false, true].map((isClone) => (
        <ul class="set" aria-hidden={isClone ? 'true' : undefined}>
          {certs.map((cert) => (
            <li class="card">
              <img
                src={cert.emblem}
                alt=""
                width="600"
                height="600"
                loading={isClone ? 'lazy' : 'eager'}
                draggable="false"
              />
              <h3>{cert.name}</h3>
              <p class="code">{cert.code}</p>
              {(cert.issued || cert.expires) && (
                <p class="validity">
                  {cert.issued && `Issued ${monthLabel(cert.issued)}`}
                  {cert.issued && cert.expires && ' · '}
                  {cert.expires && `Valid through ${monthLabel(cert.expires)}`}
                </p>
              )}
              <a
                class="verify"
                href={cert.credly}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={isClone ? -1 : undefined}
              >
                ⟨ Verify ⟩
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .carousel {
    /* Edge fades: the strip dissolves before it hits either side, so cards
       appear from nothing on the right and melt away on the left. */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
    animation: drift 32s linear infinite;
  }

  /* Engagement stops the motion: hover, keyboard focus, or a click (the
     script toggles .pinned). */
  .carousel:hover .track,
  .carousel:focus-within .track,
  .carousel.pinned .track {
    animation-play-state: paused;
  }

  @keyframes drift {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .set {
    display: flex;
    gap: var(--space-sm);
    /* The gap BETWEEN the two sets, so the wrap seam is spaced like every
       other card boundary. */
    padding-right: var(--space-sm);
    list-style: none;
    margin: 0;
    padding-left: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 13.5rem;
    padding: var(--space-md) var(--space-sm);
    background: var(--color-paper-2);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--color-accent);
    }
  }

  .card img {
    width: 6.5rem;
    height: 6.5rem;
    user-select: none;
    -webkit-user-drag: none;
  }

  .card h3 {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .code {
    margin-top: var(--space-3xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .validity {
    margin-top: var(--space-2xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-2);
  }

  .verify {
    margin-top: var(--space-sm);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Reduced motion: no drift, no duplicate set, no edge fade — a plain row
     the reader scrolls themselves. */
  @media (prefers-reduced-motion: reduce) {
    .carousel {
      -webkit-mask-image: none;
      mask-image: none;
      overflow-x: auto;
    }

    .track {
      animation: none;
    }

    .set[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  // Hover already pauses via CSS; a click pins the pause so touch users (no
  // hover) and anyone wanting a longer look can stop the strip outright.
  // Clicking the background toggles; clicking a card's verify link is a
  // navigation and is left alone.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');

  carousel?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) return;
    carousel.classList.toggle('pinned');
  });
</script>
