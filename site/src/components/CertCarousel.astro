---
import { profile } from '../data/profile';

// The certifications as a moving, draggable carousel (DECISIONS.md #51c): a
// strip of cards drifting right-to-left, dissolving at the left edge and
// materialising at the right. It stops when the reader engages — hover,
// focus, or a drag — and the reader can throw it either direction by hand.
//
// The drift is driven by requestAnimationFrame rather than a CSS animation,
// and that is the whole reason dragging works: both the automatic motion and
// the finger are writing to ONE number (`offset`). A CSS animation would own
// the transform, and a drag would have to fight it — pausing, reading the
// computed matrix, and re-syncing on release. One variable, two inputs, no
// reconciliation.
//
// The loop is two identical sets on one track; `offset` wraps at half the
// track's width, so the second set is standing exactly where the first began
// and the seam never shows. The clone is aria-hidden with untabbable links so
// assistive tech and the Tab key meet each certification once.
//
// Without JavaScript, or with reduced motion, it degrades to a plain
// horizontally-scrollable row — no drift, no clone, no mask.

const certs = profile.certifications.earned;

const monthLabel = (ym: string | null) => {
  if (!ym) return null;
  const [y, m] = ym.split('-').map(Number);
  return new Date(y, (m ?? 1) - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<div class="carousel" data-carousel aria-label="AWS certifications">
  <div class="track" data-carousel-track>
    {
      [false, true].map((isClone) => (
        <ul class="set" aria-hidden={isClone ? 'true' : undefined}>
          {certs.map((cert) => (
            <li class="card">
              <img
                src={cert.emblem}
                alt=""
                width="600"
                height="600"
                loading={isClone ? 'lazy' : 'eager'}
                draggable="false"
              />
              <h3>{cert.name}</h3>
              <p class="code">{cert.code}</p>
              {(cert.issued || cert.expires) && (
                <p class="validity">
                  {cert.issued && `Issued ${monthLabel(cert.issued)}`}
                  {cert.issued && cert.expires && ' · '}
                  {cert.expires && `Valid through ${monthLabel(cert.expires)}`}
                </p>
              )}
              <a
                class="verify"
                href={cert.credly}
                target="_blank"
                rel="noopener noreferrer"
                tabindex={isClone ? -1 : undefined}
                draggable="false"
              >
                ⟨ Verify ⟩
              </a>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>

<style>
  .carousel {
    /* Until the script takes over it is an ordinary scrollable row, so a
       no-JS reader can still reach every card. */
    overflow-x: auto;
    scrollbar-width: none;
  }

  .carousel::-webkit-scrollbar {
    display: none;
  }

  /* Edge fades: cards appear from nothing on the right and melt away on the
     left, which is what makes it read as continuous rather than as a list
     that happens to be clipped. */
  .carousel.is-live {
    overflow: hidden;
    cursor: grab;
    /* Horizontal gestures belong to the strip, vertical ones to the page.
       Without this the browser claims a sideways swipe before the script has
       seen enough movement to call it a drag, and cancels the pointer. */
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
    mask-image: linear-gradient(
      to right,
      transparent,
      black 3rem,
      black calc(100% - 3rem),
      transparent
    );
  }

  .carousel.is-live.dragging {
    cursor: grabbing;
  }

  .track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .set {
    display: flex;
    gap: var(--space-sm);
    /* The gap between the two sets, so the wrap seam is spaced like every
       other card boundary. */
    padding: 0 var(--space-2xs) 0 0;
    margin: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 13.5rem;
    padding: var(--space-md) var(--space-sm);
    background: var(--color-paper-2);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    transition:
      transform var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
  }

  @media (hover: hover) {
    .card:hover {
      transform: translateY(-3px);
      border-color: var(--color-accent);
    }
  }

  .card img {
    width: 6.5rem;
    height: 6.5rem;
    user-select: none;
    -webkit-user-drag: none;
  }

  .card h3 {
    margin-top: var(--space-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-wrap: balance;
  }

  .code {
    margin-top: var(--space-3xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .validity {
    margin-top: var(--space-2xs);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-2);
  }

  .verify {
    margin-top: var(--space-sm);
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  /* Reduced motion: the clone and the mask go, leaving the plain scroll row
     the markup already is. The script never starts. */
  @media (prefers-reduced-motion: reduce) {
    .set[aria-hidden='true'] {
      display: none;
    }
  }
</style>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  const track = document.querySelector<HTMLElement>('[data-carousel-track]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (carousel && track && !reduced) {
    const SPEED = 34; // px per second, right-to-left

    // How far the pointer must travel before a press counts as a drag rather
    // than a click. Below this the strip does not move and nothing is captured.
    const DRAG_THRESHOLD = 6;

    let half = 0; // width of one set: the point the offset wraps at
    let offset = 0;
    let paused = false;
    let pressed = false;
    let dragging = false;
    let suppressClick = false;
    let pointerId: number | null = null;
    let startX = 0;
    let startOffset = 0;
    let last = performance.now();

    const measure = () => {
      half = track.scrollWidth / 2;
    };

    // Positive offset moves the strip left. Wrapping in both directions means
    // a drag can run past either end and still land somewhere valid.
    const draw = () => {
      if (half > 0) offset = ((offset % half) + half) % half;
      track.style.transform = `translate3d(${-offset}px, 0, 0)`;
    };

    const frame = (now: number) => {
      const dt = Math.min((now - last) / 1000, 0.05); // clamp: a backgrounded
      last = now; // tab returns with a huge delta and would jump the strip
      if (!paused && !dragging) offset += SPEED * dt;
      draw();
      requestAnimationFrame(frame);
    };

    carousel.classList.add('is-live');
    measure();
    requestAnimationFrame(frame);

    // Images land after first paint and change the track's width.
    window.addEventListener('load', measure);
    if ('ResizeObserver' in window) new ResizeObserver(measure).observe(track);

    // Engagement stops it: hovering to read, or tabbing to a Verify link.
    carousel.addEventListener('pointerenter', () => (paused = true));
    carousel.addEventListener('pointerleave', () => (paused = false));
    carousel.addEventListener('focusin', () => (paused = true));
    carousel.addEventListener('focusout', () => (paused = false));

    // --- drag ---------------------------------------------------------------
    //
    // A press is NOT a drag until the pointer has actually travelled, and the
    // pointer is NOT captured until then either. That ordering is the whole
    // fix for the Verify links.
    //
    // Capturing on pointerdown — which is the obvious way to write this, and
    // what this did until 2026-08-31 — silently breaks every link inside the
    // strip. Per the Pointer Events spec, if a pointer is still captured when
    // pointerup is dispatched, the click that follows is retargeted to the
    // CAPTURE element rather than to the element actually under the pointer.
    // So the click landed on the carousel, the <a> never saw it, and no
    // amount of staring at the anchor explained why. Capture only once a real
    // drag is under way and an ordinary click never involves capture at all.
    carousel.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 && event.pointerType === 'mouse') return;
      pressed = true;
      dragging = false;
      suppressClick = false;
      pointerId = event.pointerId;
      startX = event.clientX;
      startOffset = offset;
    });

    carousel.addEventListener('pointermove', (event) => {
      if (!pressed || event.pointerId !== pointerId) return;
      const dx = event.clientX - startX;

      if (!dragging) {
        if (Math.abs(dx) < DRAG_THRESHOLD) return;
        // Now it is a drag: take the pointer, so the strip keeps following a
        // finger or cursor that wanders outside the carousel mid-throw.
        dragging = true;
        carousel.classList.add('dragging');
        carousel.setPointerCapture(pointerId);
      }

      // Drag right, the strip follows right; drag left, it follows left.
      offset = startOffset - dx;
      draw();
    });

    const endDrag = (event: PointerEvent) => {
      if (!pressed || event.pointerId !== pointerId) return;

      if (dragging) {
        // Let go of a moving strip and the browser still fires a click. That
        // click is the tail of a drag, not an intent to follow a link, so it
        // is swallowed once by the capture-phase listener below.
        suppressClick = true;
        carousel.classList.remove('dragging');
        if (carousel.hasPointerCapture(event.pointerId)) {
          carousel.releasePointerCapture(event.pointerId);
        }
      }

      pressed = false;
      dragging = false;
      pointerId = null;
      // The drift resumes on its own once the pointer leaves; pointerleave
      // may not fire after a capture, so clear the pause when the pointer is
      // no longer over the strip.
      paused = carousel.matches(':hover');
    };

    carousel.addEventListener('pointerup', endDrag);
    carousel.addEventListener('pointercancel', endDrag);

    // Swallows exactly one click, and only after a drag. Keyed off a flag set
    // when the drag ends rather than off a distance that outlives the
    // gesture — the old version compared a `moved` value that no keyboard
    // activation ever reset, so pressing Enter on a Verify link after any
    // drag was silently dropped too.
    carousel.addEventListener(
      'click',
      (event) => {
        if (!suppressClick) return;
        suppressClick = false;
        event.preventDefault();
        event.stopPropagation();
      },
      true,
    );
  }
</script>
