---
import { profile } from '../data/profile';

// The AI assistant. DECISIONS.md #11, #12, #20, #46/#48, #52.
//
// This renders the panel and its behaviour, once per page, mounted from
// DocumentLayout. The button that opens it lives in ChatLauncher and is bound
// by attribute — any `[data-chat-open]` works, so a second trigger can be
// added anywhere without touching this file.
//
// DECISIONS.md #52 — a NON-modal <dialog>, anchored to the robot and scaled
// out of its corner, the way a messenger chat head expands on Android. The
// page behind stays lit, scrollable and readable, which is the point: most
// questions here are about something the reader can see, and a modal that
// blacks out the page makes them close it to check and lose the thread.
//
// What show() does not give us that showModal() did — Escape, click-away and
// returning focus to the button — is re-implemented in the script below. Focus
// trapping deliberately is not: a non-modal popup that holds the keyboard
// hostage is the worse bug of the two.
//
// DECISIONS.md #20 — the label is not decoration. Anyone reading an answer
// needs to know a model wrote it and that it can be wrong, before they act on
// anything it says about a candidate's qualifications.
---

<dialog id="chat-panel" class="chat" data-chat aria-labelledby="chat-title">
  <header class="chat-head">
    {/* The same face as the launcher's greeting card, so the panel that opens
        is visibly the thing that waved. */}
    <span class="avatar" aria-hidden="true">
      <svg viewBox="0 0 48 48" width="20" height="20" focusable="false">
        <rect x="11" y="15" width="26" height="20" rx="6" fill="var(--color-paper)" stroke="var(--color-ink-2)" stroke-width="2" />
        <circle cx="19" cy="24" r="2.8" fill="var(--color-accent)" />
        <circle cx="29" cy="24" r="2.8" fill="var(--color-accent)" />
        <path d="M20 29.5h8" stroke="var(--color-ink-2)" stroke-width="2" stroke-linecap="round" />
        <line x1="24" y1="10" x2="24" y2="15" stroke="var(--color-ink-2)" stroke-width="2" />
        <circle cx="24" cy="7.5" r="2.5" fill="var(--color-accent)" />
      </svg>
    </span>
    <div class="who">
      <h2 id="chat-title">Ask about Luis</h2>
      <p class="disclaimer">AI assistant — it can be wrong.</p>
    </div>
    <button class="chat-close" type="button" data-chat-close aria-label="Close">×</button>
  </header>

  {/* aria-live so a screen reader hears each answer as it arrives; the
      transcript is a log, which is the role that matches how it is read. */}
  <div class="log" role="log" aria-live="polite" aria-atomic="false" data-chat-log>
    <p class="msg msg--bot">
      Ask me about Luis's certifications, projects, experience, or how this site is built.
    </p>
  </div>

  <div class="foot">
    {/* Shown only in the last few questions of the hour. A counter that is
        always visible turns every message into a countdown; one that appears
        at three left is a warning, which is what it is for. */}
    <p class="remaining" data-chat-remaining hidden></p>

    <form class="chat-form" data-chat-form>
      <label class="visually-hidden" for="chat-input">Your question</label>
      <input
        id="chat-input"
        type="text"
        name="message"
        placeholder="Ask a question…"
        autocomplete="off"
        maxlength="1000"
        required
        data-chat-input
      />
      <button type="submit" data-chat-send aria-label="Send">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false">
          <path
            d="M4 12h13M11 6l6 6-6 6"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </form>

    {/* Replaces the composer when the assistant will not answer again. A
        disabled input with no explanation is a dead end; this always leaves
        one thing the reader can still do. */}
    <div class="closed" data-chat-closed hidden>
      <div class="closed-actions">
        <button type="button" data-chat-restart hidden>Start a new conversation</button>
        <button type="button" class="copy" data-chat-copy-email={profile.email}>
          <span data-chat-copy-label>Copy Luis's email</span>
        </button>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Anchored to the robot, not to the viewport centre. The three --launcher-*
     tokens are shared with ChatLauncher, so the panel sits exactly one gap
     above the button it grew out of and stays there when that button shrinks
     on phones. */
  .chat {
    position: fixed;
    inset: auto;
    right: var(--launcher-inset-x);
    bottom: calc(var(--launcher-inset-y) + var(--launcher-size) + var(--space-2xs));
    z-index: 36;
    margin: 0;

    width: min(23rem, calc(100vw - 2 * var(--launcher-inset-x)));
    /* Never taller than the space above the robot. Without this the panel
       runs off the top of a short viewport. */
    max-height: min(
      32rem,
      calc(100dvh - var(--launcher-inset-y) - var(--launcher-size) - var(--space-md))
    );

    padding: 0;
    background: var(--color-paper);
    color: var(--color-ink);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    box-shadow: 0 10px 30px oklch(0% 0 0 / 0.2);
    overflow: hidden;

    /* The panel is a column: fixed header, scrolling log, fixed composer. */
    flex-direction: column;

    /* Scales out of the robot's corner and collapses back into it. Same
       origin and easing as the launcher's greeting card, so the two read as
       one object appearing at two sizes rather than as two popups. */
    transform-origin: bottom right;
    opacity: 0;
    transform: scale(0.94) translateY(10px);

    /* `display` is in the list so the panel is still on screen while it
       shrinks away; without it close() removes it instantly and there is no
       exit animation to see. transition-behavior is a separate longhand on
       purpose — an engine that does not know it drops that one declaration
       and loses the exit animation, rather than invalidating the whole
       shorthand and losing the fade with it. */
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      display var(--dur-base) var(--ease-out);
    transition-behavior: allow-discrete;
  }

  .chat[open] {
    display: flex;
    opacity: 1;
    transform: none;
  }

  /* The state to animate FROM on the frame the panel is first shown. A
     transition needs a previous value, and an element that was display:none
     has none. */
  @starting-style {
    .chat[open] {
      opacity: 0;
      transform: scale(0.94) translateY(10px);
    }
  }

  /* Non-modal dialogs have no ::backdrop, and that is the point: nothing
     dims, nothing goes inert, the page stays readable underneath. */

  .chat-head {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-xs);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
    background: var(--color-chrome);
  }

  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.9rem;
    height: 1.9rem;
    background: var(--color-paper);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: 50%;
  }

  .who {
    flex: 1;
    min-width: 0;
  }

  .chat-head h2 {
    font-family: var(--font-chrome);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
  }

  .disclaimer {
    max-width: none;
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    line-height: var(--leading-snug);
    color: var(--color-ink-3);
  }

  .chat-close {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    background: none;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--color-ink-3);
    font-size: var(--text-lg);
    line-height: 1;
    cursor: pointer;
  }

  .chat-close:hover {
    background: var(--color-paper-2);
    color: var(--color-ink);
  }

  .log {
    flex: 1;
    overflow-y: auto;
    /* The page behind is not inert any more, so a flick that reaches the end
       of the transcript must stop there rather than scrolling the document
       out from under the reader. */
    overscroll-behavior: contain;
    padding: var(--space-sm);
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
  }

  .msg {
    max-width: 92%;
    margin: 0;
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    white-space: pre-wrap;
    /* Each bubble arrives the way it would in a messenger thread. Silenced
       wholesale by the reduced-motion rule in global.css. */
    animation: msg-in var(--dur-base) var(--ease-out) both;
  }

  @keyframes msg-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  /* One square corner on the side the message came from — the messenger tail,
     without a tail to draw. */
  .msg--bot {
    justify-self: start;
    background: var(--color-chrome);
    color: var(--color-ink);
    border-bottom-left-radius: 0;
  }

  .msg--user {
    justify-self: end;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-bottom-right-radius: 0;
  }

  .msg--pending {
    color: var(--color-ink-3);
    font-style: normal;
  }

  .foot {
    border-top: var(--rule-hairline) solid var(--color-rule);
  }

  .remaining {
    max-width: none;
    padding: var(--space-2xs) var(--space-sm) 0;
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    color: var(--color-ink-3);
  }

  .chat-form {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: var(--space-2xs) var(--space-sm) var(--space-xs);
  }

  .closed {
    padding: var(--space-xs) var(--space-sm);
  }

  .closed-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .closed-actions button {
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-chrome);
    color: var(--color-ink);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-chrome);
    font-size: var(--text-2xs);
    cursor: pointer;
  }

  .closed-actions button:hover {
    background: var(--color-paper-2);
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .chat-form input {
    flex: 1;
    min-width: 0;
    padding: var(--space-2xs) var(--space-xs);
    background: var(--color-paper);
    color: var(--color-ink);
    border: var(--rule-hairline) solid var(--color-rule);
    border-radius: 999px;
    font-size: var(--text-sm);
  }

  /* A round send key rather than the word: at this width "Send" costs a third
     of the composer, and the arrow is the shape every messenger has trained
     people to look for. The accessible name is on the button. */
  .chat-form button {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    background: var(--color-accent);
    color: var(--color-on-accent);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .chat-form button:hover:not(:disabled) {
    transform: scale(1.08);
  }

  .chat-form button:disabled {
    opacity: 0.55;
    cursor: default;
  }

  /* On a phone the panel spans the gutters and stops short of the robot,
     which stays visible underneath — tapping it is still the way back out,
     exactly as a chat head behaves. */
  @media (max-width: 34rem) {
    .chat {
      left: var(--launcher-inset-x);
      width: auto;
      max-height: min(
        28rem,
        calc(100dvh - var(--launcher-inset-y) - var(--launcher-size) - var(--space-md))
      );
    }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-chat]');
  const log = document.querySelector<HTMLElement>('[data-chat-log]');
  const form = document.querySelector<HTMLFormElement>('[data-chat-form]');
  const input = document.querySelector<HTMLInputElement>('[data-chat-input]');
  const send = document.querySelector<HTMLButtonElement>('[data-chat-send]');
  const closedPanel = document.querySelector<HTMLElement>('[data-chat-closed]');
  const restart = document.querySelector<HTMLButtonElement>('[data-chat-restart]');
  const remainingEl = document.querySelector<HTMLElement>('[data-chat-remaining]');

  if (dialog && log && form && input && send && closedPanel && restart && remainingEl) {
    // DECISIONS.md #12 — 12 turns, matching the server's cap. Enforced in both
    // places: the client for a clear message, the server because a client-side
    // limit is a suggestion.
    const MAX_TURNS = 12;
    const OPENING = 'Ask me about Luis’s certifications, projects, experience, or how this site is built.';

    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-chat-open]'));

    let history: { role: 'user' | 'assistant'; content: string }[] = [];
    let busy = false;
    let closed = false;

    function bubble(text: string, who: 'user' | 'bot', pending = false) {
      const p = document.createElement('p');
      p.className = `msg msg--${who}${pending ? ' msg--pending' : ''}`;
      p.textContent = text;
      log!.append(p);
      log!.scrollTop = log!.scrollHeight;
      return p;
    }

    /**
     * Closes the composer and offers what is still possible.
     *
     * `turn_cap` is the only reason a new conversation helps — the hourly
     * limit and the monthly budget both survive a reset, so offering "start
     * over" there would be a button that does nothing.
     */
    function close(reason: string) {
      closed = true;
      form!.hidden = true;
      remainingEl!.hidden = true;
      closedPanel!.hidden = false;
      restart!.hidden = reason !== 'turn_cap';
    }

    function reopen() {
      closed = false;
      history = [];
      log!.replaceChildren();
      bubble(OPENING, 'bot');
      closedPanel!.hidden = true;
      form!.hidden = false;
      input!.disabled = false;
      send!.disabled = false;
      input!.focus();
    }

    /**
     * SHA-256 of the request body, hex, for the `x-amz-content-sha256` header.
     *
     * Not optional, and not a CloudFront detail we could ignore: the /api/*
     * origin is a Lambda function URL reached through Origin Access Control,
     * so CloudFront signs each origin request with SigV4 — and **Lambda does
     * not accept unsigned payloads**. CloudFront folds this header into the
     * signature it computes, so without it every POST is rejected by the
     * Lambda service with 403 before the handler runs, and the site's own 404
     * page comes back in place of an answer.
     *
     * https://docs.aws.amazon.com/AmazonCloudFront/latest/DeveloperGuide/private-content-restricting-access-to-lambda.html
     *
     * The hash must cover the exact bytes sent, so the caller hashes the
     * serialised string and posts that same string — never a re-serialisation,
     * which could differ by key order or spacing.
     */
    async function bodyHash(payload: string): Promise<string> {
      const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(payload));
      return Array.from(new Uint8Array(digest), (b) => b.toString(16).padStart(2, '0')).join('');
    }

    function showRemaining(remaining: unknown) {
      // Only in the last stretch. A number on screen from the first message
      // turns a conversation into a countdown.
      if (typeof remaining !== 'number' || remaining > 3) {
        remainingEl!.hidden = true;
        return;
      }
      remainingEl!.textContent =
        remaining <= 0
          ? 'No questions left this hour.'
          : `${remaining} question${remaining === 1 ? '' : 's'} left this hour.`;
      remainingEl!.hidden = false;
    }

    // --- open and close ----------------------------------------------------
    //
    // show(), not showModal(): the panel sits beside the robot with the page
    // live behind it (#52). Everything showModal() handled for free is below.

    /** The robot is the disclosure control, so it carries the open state. */
    function expose(isOpen: boolean) {
      for (const trigger of triggers) trigger.setAttribute('aria-expanded', String(isOpen));
    }

    function open() {
      if (dialog!.open) return;
      dialog!.show();
      expose(true);
      // The launcher's greeting card occupies exactly this spot, so it has to
      // go before the panel lands on top of it. Announced rather than inferred
      // from a click on the robot: Alt+K and a suggestion button both open the
      // panel without one, and both used to leave the card stranded underneath.
      document.dispatchEvent(new CustomEvent('chat:open'));
      // A reopened panel keeps its transcript, and returning to the top of an
      // old conversation reads as a bug.
      log!.scrollTop = log!.scrollHeight;
      if (!closed) input!.focus();
    }

    /**
     * The transcript and any half-typed question both survive a close, so
     * there is nothing to lose by closing — which is what makes tapping away
     * safe rather than punishing.
     */
    function hide() {
      if (!dialog!.open) return;
      // Only pull focus back to the robot if focus was inside the panel.
      // Closing because the reader clicked something else on the page must not
      // yank the caret out of whatever they clicked.
      const hadFocus = dialog!.contains(document.activeElement);
      dialog!.close();
      if (hadFocus) triggers[0]?.focus();
    }

    function toggle() {
      if (dialog!.open) hide();
      else open();
    }

    dialog.addEventListener('close', () => expose(false));

    // The robot toggles, the way a chat head does — the button that opened the
    // panel is the button that puts it away.
    for (const trigger of triggers) trigger.addEventListener('click', toggle);
    document.querySelector('[data-chat-close]')?.addEventListener('click', () => hide());
    restart.addEventListener('click', reopen);

    // Tap away to dismiss. A non-modal dialog gets no backdrop to click, so
    // the document is the backdrop; the panel and the robot are the two
    // exceptions — the robot because its own toggle handles it, and running
    // both would close the panel and immediately reopen it.
    document.addEventListener('pointerdown', (event) => {
      if (!dialog!.open) return;
      const target = event.target as Element | null;
      if (target?.closest('[data-chat]') || target?.closest('[data-chat-open]')) return;
      hide();
    });

    // A suggested question from the launcher's popup (#51c): open the panel
    // and send it, so the visitor gets an answer without typing. Routed
    // through the form's own submit handler rather than a second copy of the
    // send logic — one path to the API, one place for it to be wrong.
    document.addEventListener('chat:ask', (event) => {
      const question = (event as CustomEvent<{ question?: string }>).detail?.question;
      if (!question || closed) return;
      open();
      input!.value = question;
      form!.requestSubmit();
    });

    // Escape, and Alt+K as advertised on the button. Both are hand-rolled:
    // only a MODAL dialog closes itself on Escape. Alt rather than Ctrl or
    // Cmd, because every single-letter Ctrl/Cmd combination is already a
    // browser command.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && dialog!.open) {
        event.preventDefault();
        hide();
        return;
      }
      if (event.altKey && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        toggle();
      }
    });

    // Its own copy button rather than the menu bar's: two elements sharing one
    // attribute would leave whichever the menu bar's querySelector found first
    // as the only working one.
    const copyButton = document.querySelector<HTMLButtonElement>('[data-chat-copy-email]');
    const copyLabel = document.querySelector<HTMLElement>('[data-chat-copy-label]');
    copyButton?.addEventListener('click', async () => {
      const address = copyButton.dataset.chatCopyEmail ?? '';
      try {
        await navigator.clipboard.writeText(address);
        if (copyLabel) {
          copyLabel.textContent = 'Copied';
          setTimeout(() => {
            copyLabel.textContent = 'Copy Luis’s email';
          }, 1600);
        }
      } catch {
        // Clipboard access can be refused. Showing the address is strictly
        // better than a button that appears to do nothing.
        if (copyLabel) copyLabel.textContent = address;
      }
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const question = input!.value.trim();
      if (!question || busy || closed) return;

      if (history.length >= MAX_TURNS * 2) {
        bubble('This conversation has run its length. You can start a fresh one below.', 'bot');
        close('turn_cap');
        return;
      }

      bubble(question, 'user');
      history.push({ role: 'user', content: question });
      input!.value = '';

      busy = true;
      send!.disabled = true;
      const pending = bubble('Thinking…', 'bot', true);

      try {
        // One serialisation, hashed and sent. See bodyHash above for why the
        // header is mandatory rather than belt-and-braces.
        const payload = JSON.stringify({ messages: history });
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'content-type': 'application/json',
            'x-amz-content-sha256': await bodyHash(payload),
          },
          body: payload,
          signal: AbortSignal.timeout(45_000),
        });

        const data = await response.json().catch(() => ({}) as Record<string, unknown>);
        const answer =
          typeof data.reply === 'string' && data.reply
            ? data.reply
            : 'The assistant is not reachable right now. Everything it would tell you is on this page.';

        pending.remove();
        bubble(answer, 'bot');

        // A stop message is not part of the conversation. Keeping it in the
        // history would send it back as context on the next turn and teach the
        // model to talk about its own rate limit.
        if (data.done) close(typeof data.reason === 'string' ? data.reason : 'unavailable');
        else {
          history.push({ role: 'assistant', content: answer });
          showRemaining(data.remaining);
        }
      } catch {
        pending.remove();
        bubble(
          'The assistant is not reachable right now. Everything it would tell you is on this page.',
          'bot',
        );
        close('unavailable');
      } finally {
        busy = false;
        send!.disabled = closed;
        if (!closed) input!.focus();
      }
    });
  }
</script>
