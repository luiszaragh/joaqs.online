---
import { profile } from '../data/profile';
import { sections } from '../data/sections';

// The navigation panel (DECISIONS.md #47): a full-height column on the left
// of the screen, separated from the document by a rule — name at the top, the
// numbered sections down the middle, the résumé at the bottom. Same data as
// the status bar (data/sections.ts), so the two cannot drift.
//
// Links are root-anchored (/#about, not #about) so the panel works identically
// from the blog and project pages, not just the home page.
//
// aria-current tracks the section under the reader, driven by the status
// bar's IntersectionObserver via the `section:change` event — one observer,
// two displays, rather than two observers disagreeing about where the reader
// is. On pages without sections the event never fires and nothing highlights,
// which is correct.
//
// Below 60rem the panel hides: there is no room for a fixed column on a
// phone, and the page is a single scroll there anyway.
---

<aside class="sidebar">
  <a class="brand" href="/#top">{profile.name}</a>

  <nav aria-label="Sections">
    <ul>
      {
        sections.map((section) => (
          <li>
            <a href={`/#${section.slug}`} data-nav-id={section.id}>
              <span class="num" aria-hidden="true">
                {section.id}
              </span>
              <span class="lbl">{section.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="foot">
    {/* DECISIONS.md #62 — the live number, from this site's own endpoint.
        Hidden until it has something true to show: a counter that renders 0
        while it is loading, or after the endpoint fails, is worse than no
        counter at all. The script unhides it. */}
    <dl class="counts" data-viewcount hidden>
      <div>
        <dt>Views</dt>
        <dd data-views-total>—</dd>
      </div>
      <div>
        <dt>Reading now</dt>
        <dd data-views-live>—</dd>
      </div>
    </dl>

    {/* #51(b) — one theme control for the whole site, floating bottom-right
        with the robot. Two controls for one state was redundant. */}
    <a class="resume" href="/resume.pdf" download="ZARA, Luis Joaquin_Resume.pdf">
      Download résumé ↓
    </a>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    inset-block: 0;
    left: 0;
    z-index: 40;
    width: var(--sidebar-width);
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    padding: var(--space-lg) var(--space-md);
    /* The fixed status bar crosses the bottom of the screen; without this the
       résumé link would sit underneath it. */
    padding-bottom: calc(var(--chrome-height) + var(--space-md));
    background: var(--color-paper);
    border-right: var(--rule-hairline) solid var(--color-rule);
    font-family: var(--font-chrome);
    overflow-y: auto;
  }

  .brand {
    color: var(--color-ink);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  .brand:hover {
    color: var(--color-accent);
  }

  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-xs);
  }

  nav a {
    display: flex;
    gap: var(--space-2xs);
    align-items: baseline;
    color: var(--color-ink-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-ink);
  }

  .num {
    display: inline-block;
    font-variant-numeric: tabular-nums;
    transition:
      transform var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  @media (hover: hover) {
    nav a:hover .num {
      transform: translateX(3px);
      color: var(--color-accent);
    }
  }

  nav a[aria-current='true'],
  nav a[aria-current='true'] .num {
    color: var(--color-accent);
  }

  .foot {
    margin-top: auto;
    display: grid;
    gap: var(--space-sm);
  }

  .foot .resume {
    color: var(--color-ink-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-bottom: var(--rule-hairline) dashed var(--color-rule);
  }

  .foot .resume:hover {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  /* Deliberately quiet. This is provenance, like the commit SHA in the status
     bar — a detail that rewards a reader who looks, not a headline. */
  .counts {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    padding-bottom: var(--space-sm);
    border-bottom: var(--rule-hairline) solid var(--color-rule);
  }

  .counts > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2xs);
  }

  .counts dt {
    font-size: var(--text-2xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-3);
  }

  .counts dd {
    margin: 0;
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-2);
  }

  @media (max-width: 59.99rem) {
    .sidebar {
      display: none;
    }
  }
</style>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.sidebar a[data-nav-id]'));

  document.addEventListener('section:change', (event) => {
    const id = (event as CustomEvent<{ id: string }>).detail?.id;
    for (const link of links) {
      if (link.dataset.navId === id) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    }
  });

  // --- the view counter (DECISIONS.md #62) ---------------------------------
  //
  // One GET on load that counts the view, then a heartbeat that only says "I
  // am still here". Splitting them is what keeps the total honest: if every
  // heartbeat counted, a tab left open overnight would read as two thousand
  // visits.
  const panel = document.querySelector<HTMLElement>('[data-viewcount]');
  const totalEl = document.querySelector<HTMLElement>('[data-views-total]');
  const liveEl = document.querySelector<HTMLElement>('[data-views-live]');

  if (panel && totalEl && liveEl) {
    const HEARTBEAT_MS = 30_000;
    let timer = 0;

    async function ping(counted: boolean) {
      try {
        const response = await fetch(`/api/views${counted ? '?count=1' : ''}`, {
          headers: { accept: 'application/json' },
          signal: AbortSignal.timeout(8000),
        });
        const data = await response.json();
        if (typeof data.total !== 'number' || typeof data.live !== 'number') return;

        totalEl!.textContent = data.total.toLocaleString();
        liveEl!.textContent = String(data.live);
        // Revealed only once there is a real number in it.
        panel!.hidden = false;
      } catch {
        // Offline, blocked, or the endpoint is unhappy. The block stays hidden
        // and the sidebar simply does not mention it.
      }
    }

    // Stop counting against a tab nobody is looking at — it is neither a
    // viewer nor worth a request every thirty seconds.
    function schedule() {
      window.clearInterval(timer);
      if (document.visibilityState !== 'visible') return;
      timer = window.setInterval(() => ping(false), HEARTBEAT_MS);
    }

    document.addEventListener('visibilitychange', () => {
      schedule();
      if (document.visibilityState === 'visible') ping(false);
    });

    ping(true);
    schedule();
  }
</script>
